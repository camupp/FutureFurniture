{
  "name": "future-furniture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write src tests .github package.json tsconfig*.json .prettierrc.json .lintstagedrc.json vite.config.ts vitest.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests .github package.json tsconfig*.json .prettierrc.json .lintstagedrc.json vite.config.ts vitest.config.ts playwright.config.ts",
    "precommit": "lint-staged && npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "check:all": "npm run check && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2",
    "@types/react-dom": "~19.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "konva": "^10.5.0",
    "react": "~19.2",
    "react-dom": "~19.2",
    "react-konva": "~19.2",
    "three": "^0.186.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
